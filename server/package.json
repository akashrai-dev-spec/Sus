{
  "name": "sus-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Sus game authoritative Socket.IO server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/words && cp src/words/words.json dist/words/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
